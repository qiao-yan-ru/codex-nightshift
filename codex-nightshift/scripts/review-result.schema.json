{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "changes_requested", "blocked"]
    },
    "summary": {
      "type": "string"
    },
    "reviewed_base": {
      "type": "string"
    },
    "reviewed_diff": {
      "type": "string"
    },
    "scope_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "required_fix": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "title",
          "file",
          "line",
          "evidence",
          "impact",
          "required_fix",
          "verification"
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "verdict",
    "summary",
    "reviewed_base",
    "reviewed_diff",
    "scope_checked",
    "findings",
    "questions",
    "residual_risks"
  ]
}
